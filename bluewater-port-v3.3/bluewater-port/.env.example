# Copy to .env and change before running anywhere other than your own machine.
POSTGRES_DB=bluewater
POSTGRES_USER=bluewater
POSTGRES_PASSWORD=bluewater
SECRET_KEY=replace-with-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# Optional: lets scripts call the REST API with the header  X-API-Key: <value>
API_KEY=
# Set to false to start with only ports, warehouses and the admin user
SEED_DEMO=true
# Host ports (all in the 6xxx range so they don't clash with your other containers)
APP_PORT=6800
DB_PORT=6543
ADMINER_PORT=6880
